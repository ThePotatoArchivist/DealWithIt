{
  "model": {
    "type": "minecraft:condition",
    "component": "dealwithit:card",
    "on_false": {
      "type": "minecraft:model",
      "model": "dealwithit:item/card"
    },
    "on_true": {
      "type": "minecraft:select",
      "cases": [
        {
          "model": {
            "type": "minecraft:condition",
            "on_false": {
              "type": "minecraft:special",
              "base": "dealwithit:item/template_card",
              "model": {
                "type": "dealwithit:card",
                "force_hidden": true
              }
            },
            "on_true": {
              "type": "minecraft:special",
              "base": "dealwithit:item/template_card_throwing",
              "model": {
                "type": "dealwithit:card",
                "force_hidden": true
              }
            },
            "property": "minecraft:using_item"
          },
          "when": [
            "thirdperson_lefthand",
            "thirdperson_righthand"
          ]
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "on_false": {
          "type": "minecraft:special",
          "base": "dealwithit:item/template_card",
          "model": {
            "type": "dealwithit:card",
            "force_hidden": false
          }
        },
        "on_true": {
          "type": "minecraft:special",
          "base": "dealwithit:item/template_card_throwing",
          "model": {
            "type": "dealwithit:card",
            "force_hidden": false
          }
        },
        "property": "minecraft:using_item"
      },
      "property": "minecraft:display_context"
    },
    "property": "minecraft:has_component"
  }
}