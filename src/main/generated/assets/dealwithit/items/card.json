{
  "model": {
    "type": "minecraft:condition",
    "component": "dealwithit:card",
    "on_false": {
      "type": "minecraft:model",
      "model": "dealwithit:item/card"
    },
    "on_true": {
      "type": "minecraft:select",
      "cases": [
        {
          "model": {
            "type": "minecraft:special",
            "base": "minecraft:item/generated",
            "model": {
              "type": "dealwithit:card",
              "force_hidden": true
            }
          },
          "when": "thirdperson_lefthand"
        },
        {
          "model": {
            "type": "minecraft:special",
            "base": "minecraft:item/generated",
            "model": {
              "type": "dealwithit:card",
              "force_hidden": true
            }
          },
          "when": "thirdperson_righthand"
        }
      ],
      "fallback": {
        "type": "minecraft:special",
        "base": "minecraft:item/generated",
        "model": {
          "type": "dealwithit:card",
          "force_hidden": false
        }
      },
      "property": "minecraft:display_context"
    },
    "property": "minecraft:has_component"
  }
}